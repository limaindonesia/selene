APP_ENVIRONMENT=DEV
APP_NAME=selene
APP_PORT=5000
LOG_TRANSPORT=FILE

MONGO1_URI=mongodb://localhost:27017
MONGO1_DBNAME=legal_form_dev
MONGO1_USERNAME=
MONGO1_PASSWORD=

MONGO2_URI=mongodb://localhost:27017
MONGO2_DBNAME=legal_form_dev
MONGO2_USERNAME=
MONGO2_PASSWORD=

# Redis configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Signed URL settings
SIGNED_URL_EXPIRATION_TIME=3600 # 1 hour

# Google Cloud Storage
GOOGLE_CLOUD_KEY_FILE=/perqara/www/selene/storage/keys/google-cloud-storage.json
GOOGLE_CLOUD_PROJECT_ID=perqara-project
GOOGLE_CLOUD_STORAGE_BUCKET=perqara-private-env-staging
GOOGLE_CLOUD_STORAGE_PATH_PREFIX=legal-forms
GOOGLE_CLOUD_STORAGE_BUCKET_PUBLIC=perqara-public-env-staging
GOOGLE_CLOUD_STORAGE_PATH_PREFIX_PUBLIC=legal-forms